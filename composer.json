{
    "name": "locksyk/api-session-bundle",
    "description": "Stateful Symfony firewalls for API endpoints: the session id travels in the Authorization Bearer header instead of a cookie, with an explicit switch-user endpoint.",
    "type": "symfony-bundle",
    "license": "GPL-2.0-only",
    "keywords": [
        "symfony",
        "bundle",
        "session",
        "api",
        "authentication",
        "bearer-token",
        "switch-user"
    ],
    "authors": [
        {
            "name": "Kris Shannon",
            "email": "kris@shannon.id.au"
        }
    ],
    "homepage": "https://github.com/LocksyK/api-session-bundle",
    "support": {
        "issues": "https://github.com/LocksyK/api-session-bundle/issues",
        "source": "https://github.com/LocksyK/api-session-bundle"
    },
    "require": {
        "php": ">=8.2",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0",
        "symfony/event-dispatcher-contracts": "^2.5 || ^3.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/security-bundle": "^6.4 || ^7.0",
        "symfony/security-core": "^6.4 || ^7.0",
        "symfony/security-http": "^6.4 || ^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "masterminds/html5": "^2.7.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^6.4 || ^7.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/security-csrf": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "LocksyK\\ApiSessionBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LocksyK\\ApiSessionBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
